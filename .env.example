# ═══════════════════════════════════════════
# IIV EDUBOT PLATFORM - Environment Variables
# ═══════════════════════════════════════════

# ──── Telegram Bot ────
BOT_TOKEN=your_bot_token_here
BOT_ADMIN_IDS=123456789,987654321
BOT_SUPERADMIN_IDS=123456789

# ──── Database (PostgreSQL) ────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=iiv_bot
DB_USER=iiv_admin
DB_PASSWORD=strong_password_here
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ──── Redis ────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_here
REDIS_DB=0
REDIS_FSM_DB=1

# ──── AI Integration ────
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=1024
AI_ENABLED=true

# ──── MinIO (File Storage) ────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minio_password_here
MINIO_BUCKET=iiv-bot-files
MINIO_SECURE=false

# ──── pgAdmin ────
PGADMIN_EMAIL=admin@iiv.uz
PGADMIN_PASSWORD=pgadmin_password_here

# ──── Grafana ────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_password_here

# ──── Security ────
SECRET_KEY=your_very_long_secret_key_here_min_64_chars
ENCRYPTION_KEY=32_byte_encryption_key_base64
JWT_SECRET=jwt_secret_key_here
ALLOWED_IPS=127.0.0.1,192.168.1.0/24
RATE_LIMIT_USER=30
RATE_LIMIT_ADMIN=60
MAX_LOGIN_ATTEMPTS=5
BAN_DURATION_MINUTES=15
SESSION_TIMEOUT_MINUTES=30

# ──── Scheduler ────
NEWS_BROADCAST_HOUR=9
NEWS_BROADCAST_MINUTE=0
RATING_CALC_DAY=mon
RATING_CALC_HOUR=8
CERTIFICATE_CHECK_DAY=1
CERTIFICATE_CHECK_HOUR=10
BACKUP_HOUR=3
CLEANUP_HOUR=4

# ──── Notification ────
QUIET_HOURS_START=22
QUIET_HOURS_END=7

# ──── Scoring ────
SCORE_EXCELLENT=10
SCORE_GOOD=7
SCORE_SATISFACTORY=4
SCORE_PARTICIPATION=1
SCORE_COURSE_COMPLETE=15
SCORE_STREAK_BONUS=5
SCORE_CHALLENGE_BONUS=3
SCORE_EXCELLENT_THRESHOLD=85
SCORE_GOOD_THRESHOLD=70
SCORE_SATISFACTORY_THRESHOLD=50

# ──── General ────
DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=Asia/Tashkent
DEFAULT_LANGUAGE=uz
PAGINATION_SIZE=10
MAX_FILE_SIZE_MB=50
